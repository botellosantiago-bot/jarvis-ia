# =============================================================================
# Jarvis :: variables de entorno
#
# 1. Copia este archivo:   cp .env.example .env.local
# 2. Llena cada valor siguiendo el comentario de arriba.
# 3. En Vercel pega LAS MISMAS en Project > Settings > Environment Variables.
#
# .env.local NUNCA se sube a git (ya esta en .gitignore). Si una llave se te
# escapa a un repo publico, rotala de inmediato en el panel donde la sacaste.
# =============================================================================


# ---------- Supabase (obligatorio) ----------
# La base de datos y el inicio de sesion.
# De donde: supabase.com > tu proyecto > Project Settings > API (o "Connect").
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL" (https://xxxx.supabase.co)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = la llave "anon" / "publishable" (es publica: viaja al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio. Solo la usan el servidor, el webhook de Telegram y el cron
# (no hay sesion de navegador ahi). Se salta la seguridad por usuario (RLS):
# NUNCA la pongas en una variable NEXT_PUBLIC_ ni la compartas.
# De donde: Project Settings > API > "service_role" (o "secret key").
SUPABASE_SERVICE_ROLE_KEY=


# ---------- Cifrado de los tokens de Google (obligatorio) ----------
# Los tokens de Google Calendar se guardan cifrados con esta clave (AES-256-GCM).
# De donde: la generas tu en la terminal con
#   openssl rand -base64 32
# Si la cambias despues, tendras que volver a conectar Google Calendar.
TOKEN_ENCRYPTION_KEY=


# ---------- Claude (obligatorio para el asistente) ----------
# El cerebro: entiende lo que escribes y lo convierte en eventos, tareas y recordatorios.
# Sin ella el hub abre, pero la barra de captura y el bot quedan apagados.
# De donde: console.anthropic.com > API Keys > Create Key (empieza con sk-ant-).
# Pon un limite de gasto mensual en Billing para dormir tranquilo.
ANTHROPIC_API_KEY=

# Opcional: otro modelo de Claude. Por defecto claude-sonnet-5-5.
# JARVIS_MODELO=


# ---------- Google Calendar (opcional, muy recomendado) ----------
# Para que los eventos se escriban en tu calendario real.
# De donde: console.cloud.google.com > APIs y servicios > Credenciales >
#   Crear credenciales > ID de cliente OAuth > Aplicacion web.
#   URIs de redireccion autorizados:
#     http://localhost:3000/api/google/callback
#     https://TU-JARVIS.vercel.app/api/google/callback
# (Paso a paso en el README, seccion "Google Calendar".)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------- URL publica ----------
# Donde vive tu Jarvis. Sirve para el regreso de Google, el boton "Abrir Jarvis"
# de Telegram y las notas de voz.
#   En tu compu:  http://localhost:3000
#   En Vercel:    https://TU-JARVIS.vercel.app  (tu dominio real, sin / al final)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---------- Telegram (opcional, muy recomendado) ----------
# Para hablarle a Jarvis desde el celular y recibir recordatorios y el resumen de la manana.
# De donde: en Telegram, escribele a @BotFather > /newbot. Te da el token y el usuario del bot.
#   TELEGRAM_BOT_USERNAME   = el usuario del bot SIN @ (p.ej. mi_jarvis_bot)
#   TELEGRAM_BOT_TOKEN      = el token que te da BotFather (numeros:letras)
#   TELEGRAM_WEBHOOK_SECRET = lo inventas tu; genera uno con: openssl rand -hex 24
#                             Telegram lo manda en cada mensaje y Jarvis rechaza lo que no lo traiga.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=


# ---------- Cron (recordatorios y resumen de la manana) ----------
# Protege /api/cron/tick para que nadie mas lo dispare.
# De donde: lo inventas tu; genera uno con: openssl rand -hex 32
# En Vercel, la variable debe llamarse exactamente CRON_SECRET: Vercel la manda sola.
CRON_SECRET=


# ---------- Personalizacion (opcional) ----------
# Como se presenta el asistente. Por defecto "Jarvis".
# JARVIS_NOMBRE=Jarvis
# Como te llama. Por defecto usa el display_name de tu perfil en Supabase.
# JARVIS_TU_NOMBRE=
# Zona horaria de respaldo. La de verdad vive en la tabla profiles (ver README).
# JARVIS_ZONA_HORARIA=America/Mexico_City


# ---------- Voz con ElevenLabs (opcional) ----------
# NO hace falta: Jarvis ya trae 18 frases grabadas en public/voz/.
# Solo si quieres generar frases nuevas con TU voz (scripts/voz/generar-frases.mjs).
# De donde: elevenlabs.io > Developers > API Keys; el Voice ID sale en Voices > tu voz.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOZ_ID=
